# MVP sem login, acessível somente neste computador.
AUTH_ENABLED=false
# Opcional no modo atual; exigido apenas ao ativar AUTH_ENABLED=true.
API_WRITE_TOKEN=troque-por-uma-senha-com-pelo-menos-24-caracteres
HOST=127.0.0.1
PORT=3001
# Origem do frontend integrado: os comprovantes usam /rastreio/:id nesse endereço.
PUBLIC_BASE_URL=http://127.0.0.1:5173
# Origens permitidas no navegador, separadas por vírgula (sem caminhos nem *).
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
