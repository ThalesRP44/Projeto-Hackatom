# Token exigido no cabeçalho Authorization: Bearer <token> das escritas.
API_WRITE_TOKEN=troque-por-uma-senha-com-pelo-menos-24-caracteres
HOST=127.0.0.1
PORT=3001
# Origem do frontend externo: os comprovantes usam /rastreio/:id nesse endereço.
PUBLIC_BASE_URL=http://127.0.0.1:5173
# Origens permitidas no navegador, separadas por vírgula (sem caminhos nem *).
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
